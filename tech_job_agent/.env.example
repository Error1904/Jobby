# Notion API Integration Credentials
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Grant read, insert, and update capabilities
# 3. Share your Notion Database with the integration
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Programmable Search API (Optional for web discovery)
# Get API key: https://developers.google.com/custom-search/v1/overview
# Get Search Engine ID (cx): https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CSE_ID=xxxxxxxxxxxxxxxxx

# Pipeline & Storage Configuration
SQLITE_DB_PATH=mumbai_tech_jobs.db
REQUEST_DELAY_SECONDS=2.0
MAX_RESULTS_PER_SEARCH=10
